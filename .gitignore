# ---- Credentials: never commit. Copy the .example files and fill them in. ----
brain.txt
brain2.txt
antropicapi.txt
anthropicapi.txt
openaiapi.txt
ket.txt
ket.txt.pub
*.pem
*.key
.env
!*.example

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ---- Generated research artifacts (regenerable; multi-GB in a live run) ----
# Anchored with a leading slash where the rule should only bite at the repo root --
# an unanchored `wiki/` would also swallow samples/wiki/.
/artifacts/
**/artifacts/
# ...except the field-cluster catalog. It is generated, but four modules hardcode this
# exact path (alpha_discovery/theory_method/context.py,
# alpha_enhancement/workshop/semantic.py, alpha_enhancement/semantic_templates/core.py,
# alpha_discovery/probe_method/build_plan.py) and the grammar lane cannot be exercised
# offline without it. Regenerate with: tools/refresh_fields_csv.py
# Un-ignore the directory so git can walk it, re-ignore its contents, then allow the
# single file -- otherwise the whole artifacts dir would be committable again.
!alpha_discovery/grammar_method/artifacts/
alpha_discovery/grammar_method/artifacts/*
!alpha_discovery/grammar_method/artifacts/all_clusters.json

/records/
/wiki/
/logs/
/test_results/
*.log

# ---- Large model/cache binaries ----
*.pkl
*.npz
*.sqlite

# ---- samples/ is curated evidence, committed on purpose ----
# It must override the *.log and *.jsonl-ish rules above.
!samples/
!samples/**

# ---- Cruft ----
*.bak
*.bak.*
*~
