# ---- Credentials: never commit. Copy the .example files and fill them in. ----
brain.txt
brain2.txt
antropicapi.txt
anthropicapi.txt
openaiapi.txt
ket.txt
ket.txt.pub
*.pem
*.key
.env
!*.example

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ---- Generated research artifacts (regenerable; multi-GB in a live run) ----
# Anchored with a leading slash so these only match at the repo root --
# an unanchored `wiki/` would also swallow samples/wiki/.
/artifacts/
*/artifacts/
# ...except the field-cluster catalog. It is generated, but four modules hardcode this
# exact path (wq_alpha/theory/context.py, wq_alpha/workshop/semantic.py,
# wq_alpha/semantic_templates/core.py, alpha_probe/build_plan.py), and the grammar
# lane cannot be exercised offline without it. Regenerate: tools/refresh_fields_csv.py
!alpha_grammar/artifacts/
!alpha_grammar/artifacts/all_clusters.json
/records/
/wiki/
/logs/
/test_results/
*.log

# ---- Large model/cache binaries ----
*.pkl
*.npz
*.sqlite

# ---- samples/ is curated evidence, committed on purpose ----
# It must override the *.log and *.jsonl-ish rules above.
!samples/
!samples/**

# ---- Cruft ----
*.bak
*.bak.*
*~
